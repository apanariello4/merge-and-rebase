{
  "suite": "vision8",
  "tasks": "all",
  "models": {
    "source": {
      "model": "ViT-B-16",
      "pretrained": "datacomp_xl_s13b_b90k"
    },
    "target": {
      "model": "ViT-L-14",
      "pretrained": "datacomp_xl_s13b_b90k"
    },
    "tuned_checkpoints": {
      "Cars": "checkpoints/ViT-B-16/datacomp_xl_s13b_b90k/Cars/best.pt",
      "DTD": "checkpoints/ViT-B-16/datacomp_xl_s13b_b90k/DTD/best.pt",
      "EuroSAT": "checkpoints/ViT-B-16/datacomp_xl_s13b_b90k/EuroSAT/best.pt",
      "GTSRB": "checkpoints/ViT-B-16/datacomp_xl_s13b_b90k/GTSRB/best.pt",
      "MNIST": "checkpoints/ViT-B-16/datacomp_xl_s13b_b90k/MNIST/best.pt",
      "RESISC45": "checkpoints/ViT-B-16/datacomp_xl_s13b_b90k/RESISC45/best.pt",
      "SUN397": "checkpoints/ViT-B-16/datacomp_xl_s13b_b90k/SUN397/best.pt",
